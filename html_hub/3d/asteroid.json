{"story":true,"autorun":[{"unless":"st_landed","actions":[{"type":"say","who":"","text":"Cold, thin air and the hum of machinery. You stand on a landing pad, stars wheeling overhead. A huge ringed planet hangs in the sky."},{"type":"say","who":"","text":"You are not on the island. You are not in the Colosseum. You are not, by the look of it, even in the same world."},{"type":"say","who":"","text":"A woman in a flight jacket is walking toward you across the pad. Speak to Captain Rhea."},{"type":"flag","key":"st_landed"}]},{"if":"sq_hound","unless":"sq_hound_r","actions":[{"type":"say","who":"","text":"The hound dissolves into a spray of motes. Where it stood, a polished shard hums softly."},{"type":"flag","key":"sq_hound_r"},{"type":"chest","loot":{"gold":1000,"gems":6,"shards":15,"equipment":["gilded_hymnal"]},"text":"You find"}],"sq":1}],"music":{"url":"/assets/Music/mp3/02. Lively City.mp3"},"name":"Outpost Kestrel","kit":"","tile":4,"pieces":[["/assets/3D/Asteroid/SM_support_module_large",-30,-20,0,-22.795,1],["/assets/3D/Asteroid/SM_support_module_large",-30,20,0,-22.795,1],["/assets/3D/Asteroid/SM_support_module_large",30,-20,0,-22.795,1],["/assets/3D/Asteroid/SM_support_module_large",30,20,0,-22.795,1],["/assets/3D/Asteroid/SM_landing_pad",0,10,0,0.02,1],["/assets/3D/Asteroid/SM_module_building_02",0,-26,0,0,1],["/assets/3D/Asteroid/SM_module_building_01",-44,-24,0,0,1],["/assets/3D/Asteroid/SM_module_building_03",44,-24,0,0,1],["/assets/3D/Asteroid/SM_house_01",-40,10,0,0,1],["/assets/3D/Asteroid/SM_house_02",-36,29,0,0,1],["/assets/3D/Asteroid/SM_house_03",24,31,0,0,1],["/assets/3D/Asteroid/SM_house_small",46,31,0,0,1],["/assets/3D/Asteroid/SM_ship_landed",38,4,0,0,1],["/assets/3D/Asteroid/SM_antenna_02",-22,-13.5,0,0,1.3],["/assets/3D/Asteroid/SM_antenna_02",22,-13.5,0,0,1.3],["/assets/3D/Asteroid/SM_antenna_03",0,-38,0,0,1.2],["/assets/3D/Asteroid/SM_crate_01",24,12.5,10,0,2.2],["/assets/3D/Asteroid/SM_crate_03",25.4,14,35,0,2.2],["/assets/3D/Asteroid/SM_c