teroid/SM_rock_01",79.664,56.987,197,-23.44,7.387],["/assets/3D/Asteroid/SM_rock_01",106.99,-48.274,97,-23.781,11.661],["/assets/3D/Asteroid/SM_rock_02",-113.177,-27.749,247,-17.551,9.793],["/assets/3D/Asteroid/SM_rock_02",65.734,34.939,122,-15.642,9.524],["/assets/3D/Asteroid/SM_ground_rocks",-52,-5,215,0,5.647],["/assets/3D/Asteroid/SM_ground_rocks",52,-12,305,0,4.982],["/assets/3D/Asteroid/SM_ground_rocks",50,18,266,0,4.351],["/assets/3D/Asteroid/SM_ground_rocks",-54,38,35,0,4.253],["/assets/3D/Asteroid/SM_table_01",0,19.5,0,0,1.3],["/assets/3D/Asteroid/SM_door_module",-27,-3,90,0,1],["/assets/3D/Asteroid/SM_crate_03",-42.3,0.3,6.14,0,2.2,"H:sq_s1"],["/assets/3D/Asteroid/SM_crate_03",24.0,-20.0,0.16,0,2.2,"H:sq_s2"],["/assets/3D/Asteroid/SM_crate_03",42.5,22.3,2.58,0,2.2,"H:sq_s3"],["/assets/3D/Asteroid/SM_crate_01",-50.1,32.1,3.82,0,2.2,"!sq_c1"],["/assets/3D/Asteroid/SM_crate_01",50.0,4.0,0.6,0,2.2,"!sq_c2"]],"colliders":[{"x":0,"z":-26,"w":23.406,"d":23.406},{"x":-44,"z":-24,"w":28.952,"d":28.952},{"x":44,"z":-24,"w":28.952,"d":28.952},{"x":-40,"z":10,"w":26.32,"d":17.108},{"x":-36,"z":29,"w":25.662,"d":17.766},{"x":24,"z":31,"w":14.1,"d":14.852},{"x":46,"z":31,"w":19.27,"d":14.852},{"x":38,"z":4,"w":21,"d":18},{"x":-22,"z":-13.5,"w":1.6,"d":1.6},{"x":22,"z":-13.5,"w":1.6,"d":1.6},{"x":24,"z":12.5,"w":1.7,"d":1.7},{"x":25.4,"z":14,"w":1.7,"d":1.7},{"x":23,"z":15,"w":1.7,"d":1.7},{"x":26,"z":10.8,"w":1.7,"d":1.7},{"x":22.5,"z":11.2,"w":1.7,"d":1.7},{"x":31,"z":17.6,"w":7,"d":5},{"x":-21.5,"z":22,"w":4.9,"d":3.7},{"x":16,"z":26.6,"w":3.7,"d":1.9},{"x":-6,"z":-14.4,"w":1.6,"d":1.8},{"x":6,"z":-14.4,"w":1.6,"d":1.8},{"x":0,"z":19.5,"w":3.4,"d":1.8},{"x":-28.2,"z":-3,"w":2.4,"d":7}],"npcs":[{"id":"rhea","name":"Captain Rhea","title":"Outpost Kestrel","sprite":"Yulia","x":0,"z":-9.6,"tint":[0.8,1,1.2,1],"reach":5,"actions":[{"type":"say","who":"Captain Rhea","text":"Easy now. You came through the rift, so you are the one the masked raiders wanted. Welcome to Outpost Kestrel, far from any sea.","unless":"st_met"},{"type":"say","who":"Captain Rhea","text":"They have been pulling fighters out of the world and dropping them on rocks like this one. We think the portal at the Colosseum was only the first door.","unless":"st_met"},{"type":"say","who":"Captain Rhea","text":"Worlds are going quiet out there, one after another. Whole skies. Our instruments read it as the dimensions folding into each other, as if something were gathering them up.","unless":"st_met"},{"type":"say","who":"Kael","text":"Gathering them for what?","unless":"st_met"},{"type":"say","who":"Captain Rhea","text":"Ask me when I know. Until then, ask Lyra.","unless":"st_met"},{"type":"say","who":"Captain Rhea","text":"We have a scholar here who has been studying the rift since she was dragged through it. Lyra. She is usually in the mess hall, west of the pad, buried in notes. Go and talk to her.","unless":"st_met"},{"type":"flag","key":"st_met","unless":"st_met"},{"type":"say","who":"Captain Rhea","text":"Lyra is in the mess hall, west of the landing pad. She knows more about the rift than all of my techs together.","if":"st_met","unless":"st_lyra"},{"type":"say","who":"Captain Rhea","text":"Lyra says there is a vault under the base, and that it is the reason the rift keeps tearing open. I had the old hatch west of the pad unsealed for you. Take Lyra, take care, and come back alive.","if":"st_lyra","unless":"vt_boss"},{"type":"say","who":"Captain Rhea","text":"The Shard stopped singing the moment the Warden fell. Good work. The rift console has a new coordinate on it now. We will find out where it points. For now, rest.","if":"vt_boss"}],"h":2.4},{"id":"battle","name":"Sergeant Kade","title":"Drill Sergeant","sprite":"Draven","x":-13,"z":18.5,"line":"Rift or no rift, soldiers stay sharp. Want a bout in the practice ring?","tint":[0.8,0.95,1.15,1],"action":"battle","h":2.4},{"id":"heroes","name":"Ysol","title":"Technician","sprite":"Lyra","x":13,"z":18.5,"line":"I tune gear and drill skills. Bring me your fighters.","tint":[0.8,1.05,1.1,1],"action":"heroes","h":2.4},{"id":"summon","name":"Oro","title":"Rift Seer","sprite":"Sera","x":-19,"z":3.5,"line":"The rift leaks. Sometimes things climb out of it and want to fight for you.","tint":[0.85,0.9,1.25,1],"action":"summon","reach":5,"h":2.4},{"id":"shop","name":"Quartermaster Pike","title":"Supplies","sprite":"Rook","x":22.5,"z":8.2,"line":"Everything we salvaged, for everything you earned. Browse.","tint":[1.1,0.95,0.8,1],"action":"shop","h":2.4},{"id":"save","name":"Archivist","title":"Records","sprite":"Kael","x":0,"z":29.5,"tint":[0.75,0.88,1.15,1],"action":"save_and_quit","h":2.4},{"id":"lyra","name":"Lyra","title":"Rift Scholar","sprite":"Lyra","x":-17,"z":19.8,"tint":[1,1,1.1,1],"hideIf":"st_lyra","reach":5,"actions":[{"type":"say","who":"Lyra","text":"Another one who fell out of the sky? ...Oh. You are the one the Captain mentioned. You came through the Colosseum portal. Good. I have a map of what is under this base, and I need someone who can fight.","if":"st_met"},{"type":"say","who":"Lyra","text":"I was a scholar at a library very far from here, until a door opened in the reading room and the floor stopped being the floor. Since then I have been tracing where the rift gets its strength.","if":"st_met"},{"type":"say","who":"Lyra","text":"The old texts I carried out of that library say the worlds were not always many. There was only the Domain, once: one being, one law, one dream. Then it broke. I used to call that a metaphor.","if":"st_met"},{"type":"say","who":"Lyra","text":"It points down. There is a vault below Kestrel, and something called a Shard in it that is pulling doors open across the world. Wherever you are going next, I would like to come with you.","if":"st_met"},{"type":"recruit","name":"Lyra","if":"st_met"},{"type":"flag","key":"st_lyra","if":"st_met"},{"type":"say","who":"Lyra","text":"Lyra joins your party. The hatch to the vault is west of the landing pad. Equip her at Ysol's bench first; I have no armour to my name.","if":"st_met"},{"type":"say","who":"Lyra","text":"The Captain wants to see you first. She is by the command dome, north of the pad.","unless":"st_met"}],"h":2.4},{"id":"sq_vel0","name":"Scrapper Vel","title":"Salvager","sprite":"Yulia","x":34.0,"z":24.0,"h":2.3,"tint":[1.1,1.0,0.8,1],"actions":[{"type":"say","who":"Scrapper Vel","text":"Three salvage crates broke loose from the cargo sled when the rift pulsed. Mostly spare parts, but one has medical stock. I'd go myself if my knee was not shot."},{"type":"say","who":"Scrapper Vel","text":"They'll be scattered around the pad. Bring me what you find and I'll share the haul."},{"type":"flag","key":"sq_salv_q"}],"hideIf":"sq_salv_q"},{"id":"sq_vel1","name":"Scrapper Vel","title":"Salvager","sprite":"Yulia","x":34.0,"z":24.0,"h":2.3,"tint":[1.1,1.0,0.8,1],"actions":[{"type":"say","who":"Scrapper Vel","text":"Still short. Three crates, scattered around the pad.","unless":"sq_s1,sq_s2,sq_s3"},{"type":"say","who":"Scrapper Vel","text":"All three! The medical stock is intact. Here, your share, and then some.","if":"sq_s1,sq_s2,sq_s3"},{"type":"chest","loot":{"gold":1200,"items":{"ether":3,"hi_potion":2},"equipment":["chorister_wand"]},"text":"Vel's share","if":"sq_s1,sq_s2,sq_s3"},{"type":"flag","key":"sq_salv_done","if":"sq_s1,sq_s2,sq_s3"}],"showIf":"sq_salv_q","hideIf":"sq_salv_done"},{"id":"sq_vel2","name":"Scrapper Vel","title":"Salvager","sprite":"Yulia","x":34.0,"z":24.0,"h":2.3,"tint":[1.1,1.0,0.8,1],"line":"Good haul, good friends. Come by any time the sled breaks again.","showIf":"sq_salv_done"},{"id":"sq_kade0","name":"Corporal Dun","title":"Patrol","sprite":"Draven","x":-9.0,"z":24.0,"h":2.3,"tint":[0.9,1.0,1.15,1],"actions":[{"type":"say","who":"Corporal Dun","text":"One of the patrol drones went rogue after the last pulse. It is camped out past the east scaffolding and it keeps shooting at the supply sleds."},{"type":"say","who":"Corporal Dun","text":"Shut it down, and the quartermaster's reserve is yours."},{"type":"flag","key":"sq_drone_q"}],"hideIf":"sq_drone_q"},{"id":"sq_kade1","name":"Corporal Dun","title":"Patrol","sprite":"Draven","x":-9.0,"z":24.0,"h":2.3,"tint":[0.9,1.0,1.15,1],"actions":[{"type":"say","who":"Corporal Dun","text":"Past the east scaffolding. It pings every few seconds, so you'll hear it."}],"showIf":"sq_drone_q","hideIf":"sq_drone"},{"id":"sq_kade2","name":"Corporal Dun","title":"Patrol","sprite":"Draven","x":-9.0,"z":24.0,"h":2.3,"tint":[0.9,1.0,1.15,1],"actions":[{"type":"say","who":"Corporal Dun","text":"Quiet at last. The reserve's yours, as promised."},{"type":"flag","key":"sq_drone_done"},{"type":"chest","loot":{"tickets":{"premium":1},"gems":8,"gold":800,"items":{"phoenix_down":1}},"text":"From the reserve"}],"showIf":"sq_drone","hideIf":"sq_drone_done"},{"id":"sq_drone","name":"Rogue Drone","title":"Malfunctioning","sprite":"Rook","x":46.8,"z":-8.1,"h":2.7,"tint":[0.6,0.9,1.2,1],"actions":[{"type":"say","who":"Rogue Drone","text":"BZZT. TARGET ACQUIRED. TARGET ACQUIRED. TARGET ACQUIRED."},{"type":"battle","key":"sq_drone","pool":["arc_drone"],"level_rel":[2,3],"elite":0.15}],"hideIf":"sq_drone","reach":5.0,"showIf":"sq_drone_q"},{"id":"sq_hound","name":"Alpha Phase Hound","title":"Rift predator","sprite":"Sera","x":-43.2,"z":-8.0,"h":2.7,"tint":[0.6,0.5,1.2,1],"actions":[{"type":"say","who":"Alpha Phase Hound","text":"The air folds in on itself. A great shape steps out of the fold, and it does not look hungry. It looks curious."},{"type":"battle","key":"sq_hound","pool":["phase_hound"],"level_rel":[0,1],"elite":0.05}],"hideIf":"sq_hound","reach":5.0},{"id":"sq_dice0","name":"Doc Ferro","title":"Dice, 250g","sprite":"Lyra","x":-20.0,"z":-22.0,"h":2.3,"tint":[0.9,1.1,1.0,1],"actions":[{"type":"say","who":"Doc Ferro","text":"Two hundred fifty. The dice don't care how pretty your sword is."},{"type":"game","game":"dice","stake":250}],"reach":4.0},{"id":"sq_dice1","name":"Quartermaster's mate","title":"High stakes, 1000g","sprite":"Rook","x":-17.4,"z":-20.6,"h":2.3,"tint":[1.2,0.9,0.7,1],"actions":[{"type":"say","who":"Quartermaster's mate","text":"A thousand. Not for the faint of purse."},{"type":"game","game":"dice","stake":1000}],"reach":4.0}],"events":[{"id":"rift_console","name":"Rift console","x":0,"z":17.5,"w":4,"d":3,"trigger":"talk","prompt":"Read the console","actions":[{"type":"say","who":"Rift Console","text":"COORDINATES CYCLING: PARADISE ISLAND... OLYMPUS COLOSSEUM... A third entry flickers and will not resolve. THE RIFT IS SEALED. The way home is not open yet.","unless":"vt_boss"},{"type":"say","who":"Rift Console","text":"COORDINATES CYCLING: PARADISE ISLAND... OLYMPUS COLOSSEUM... A third entry has resolved: UNKNOWN. SIGNAL STRENGTH RISING. The way home is still sealed, but something on the other end has noticed us.","if":"vt_boss"}]},{"id":"ship_note","name":"Landed ship","x":38,"z":14.4,"w":8,"d":3,"trigger":"talk","prompt":"Look at the ship","actions":[{"type":"say","who":"","text":"Scorched hull plates and a cracked canopy. Someone brought this ship in the hard way."}]},{"id":"vault_hatch","name":"Vault hatch","x":-24,"z":-3,"w":4,"d":5,"trigger":"talk","prompt":"Open the hatch","actions":[{"type":"say","who":"","text":"A heavy hatch, scorched and sealed. Something below it hums.","unless":"st_lyra"},{"type":"say","who":"","text":"The hatch grinds open on a staircase that spirals down into violet light. The air tastes of metal and old storms.","if":"st_lyra"},{"type":"warp","scene":"vault","x":0,"z":10,"if":"st_lyra"}]},{"id":"rift_gate","name":"Rift gate","x":14,"z":23,"w":5.0,"d":4.0,"trigger":"talk","prompt":"Step into the rift","actions":[{"type":"say","who":"","text":"The air above the pad is quiet. Nothing answers the console yet.","unless":"vt_boss"},{"type":"say","who":"Captain Rhea","text":"The new coordinate resolved overnight. The rift has torn open past the pad: a chain of broken ruins hanging in nothing. Whatever is calling, it is on the far side. Come back alive.","if":"vt_boss","unless":"rc_arrive"},{"type":"say","who":"","text":"A wound in the sky hangs open, bleeding violet light. You step through.","if":"vt_boss"},{"type":"warp","scene":"reach","x":0,"z":8,"if":"vt_boss"}]},{"id":"sq_s1","name":"Salvage crate","x":-42.3,"z":0.3,"w":3.2,"d":3.2,"trigger":"talk","prompt":"Search the crate","actions":[{"type":"say","who":"","text":"A cargo crate lies split open, packed with salvage tags and spare parts."},{"type":"flag","key":"sq_s1"}],"showIf":"sq_salv_q","hideIf":"sq_s1"},{"id":"sq_s2","name":"Salvage crate","x":24.0,"z":-20.0,"w":3.2,"d":3.2,"trigger":"talk","prompt":"Search the crate","actions":[{"type":"say","who":"","text":"A cargo crate lies split open, packed with salvage tags and spare parts."},{"type":"flag","key":"sq_s2"}],"showIf":"sq_salv_q","hideIf":"sq_s2"},{"id":"sq_s3","name":"Salvage crate","x":42.5,"z":22.3,"w":3.2,"d":3.2,"trigger":"talk","prompt":"Search the crate","actions":[{"type":"say","who":"","text":"A cargo crate lies split open, packed with salvage tags and spare parts."},{"type":"flag","key":"sq_s3"}],"showIf":"sq_salv_q","hideIf":"sq_s3"},{"id":"sq_fix","name":"Repair bench","x":-28.0,"z":-22.0,"w":3.4,"d":3.2,"trigger":"talk","prompt":"Rest","actions":[{"type":"say","who":"","text":"You sit on the workbench for a few minutes while the hum of the pad evens out your breathing."},{"type":"rest"}]},{"id":"sq_c1","name":"Treasure chest","x":-50.1,"z":32.1,"w":3.4,"d":3.4,"trigger":"talk","prompt":"Open the chest","actions":[{"type":"flag","key":"sq_c1"},{"type":"chest","loot":{"gold":500,"items":{"hi_potion":1,"ether":1}},"text":"You open the chest and find"}],"hideIf":"sq_c1"},{"id":"sq_c2","name":"Treasure chest","x":50.0,"z":4.0,"w":3.4,"d":3.4,"trigger":"talk","prompt":"Open the chest","actions":[{"type":"flag","key":"sq_c2"},{"type":"chest","loot":{"gold":700,"shards":8,"gems":3},"text":"You open the chest and find"}],"hideIf":"sq_c