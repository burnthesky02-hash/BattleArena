{
 "story": true,
 "autorun": [
  {
   "unless": "st_landed",
   "actions": [
    {
     "type": "say",
     "who": "",
     "text": "Cold, thin air and the hum of machinery. You stand on a landing pad, stars wheeling overhead. A huge ringed planet hangs in the sky."
    },
    {
     "type": "say",
     "who": "",
     "text": "You are not on the island. You are not in the Colosseum. You are not, by the look of it, even in the same world."
    },
    {
     "type": "say",
     "who": "Rook",
     "text": "Outpost Kestrel. Not much to look at, but nobody here sells tickets. Go on, Miya has been pacing a hole in the deck waiting for you."
    },
    {
     "type": "say",
     "who": "",
     "text": "Miya is waiting at the edge of the pad. Beyond her, a woman in a flight jacket watches from the far end: Captain Rhea. Speak to Miya first."
    },
    {
     "type": "flag",
     "key": "st_landed"
    }
   ]
  },
  {
   "if": "sq_hound",
   "unless": "sq_hound_r",
   "actions": [
    {
     "type": "say",
     "who": "",
     "text": "The hound dissolves into a spray of motes. Where it stood, a polished shard hums softly."
    },
    {
     "type": "flag",
     "key": "sq_hound_r"
    },
    {
     "type": "chest",
     "loot": {
      "gold": 1000,
      "gems": 6,
      "shards": 15,
      "equipment": [
       "gilded_hymnal"
      ]
     },
     "text": "You find"
    }
   ],
   "sq": 1
  }
 ],
