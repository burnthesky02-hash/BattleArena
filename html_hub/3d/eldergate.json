39.4,"z":-25.5,"r":3.6,"color":[0.35,0.95,0.85,0.35]},{"type":"glow","x":-35.8,"z":-35.5,"r":6,"color":[0.35,0.95,0.85,0.3]},{"type":"glyph","x":-37.0,"z":-30.0,"r":4.5,"spin":-25,"color":[0.35,0.95,0.85,0.9]},{"type":"glow","x":35.0,"z":-35.0,"r":6,"color":[1,0.75,0.4,0.3]},{"type":"glow","x":35.0,"z":-25.0,"r":6,"color":[1,0.75,0.4,0.3]},{"type":"glow","x":37.5,"z":-30.0,"r":5,"color":[1,0.85,0.5,0.3]},{"type":"glyph","x":0,"z":27.5,"r":3.2,"spin":20,"color":[1,0.85,0.6,0.9]},{"type":"glow","x":0,"z":26,"r":6,"color":[1,0.85,0.6,0.3]}],"npcs":[],"events":[{"id":"eg_p1","name":"Chronicle I","x":-6.5,"z":21.0,"w":3.4,"d":2.6,"trigger":"talk","prompt":"Read the plate","actions":[{"type":"say","who":"Chronicle I","text":"ELDERGATE, SEAT OF THE KINGDOM OF THE OPEN DOOR. OUR FOUNDERS HELD THAT THE GREATEST DANGER TO ANY PEOPLE IS TO BE ALONE."},{"type":"say","who":"Chronicle I","text":"THE SCHOLARS OF THE HIGH COLLEGE PROVED WHAT THE POETS HAD ONLY GUESSED: THE UNIVERSE IS NOT ONE CONTINUOUS WORLD. WORLDS LIE BESIDE ONE ANOTHER, PARTED BY BARRIERS THAT KNOWLEDGE CAN CROSS."},{"type":"say","who":"Lyra","text":"That is the theory I spent half my life chasing. They built a city on it."},{"type":"say","who":"Miya","text":"A kingdom that believed isolation was the danger. After the Colosseum, I find I cannot argue with them."},{"type":"flag","key":"eg_t1"}]},{"id":"eg_p2","name":"Chronicle II","x":6.5,"z":15.0,"w":3.4,"d":2.6,"trigger":"talk","prompt":"Read the plate","actions":[{"type":"say","who":"Chronicle II","text":"THE ELDERGATE NETWORK. A GATE FOR EVERY WORLD THAT ANSWERED. THROUGH THEM WENT GRAIN AND GLASS, MEDICINE AND SONG, AND FOR GENERATIONS NO CHILD OF THE KINGDOM WENT HUNGRY."},{"type":"say","who":"Chronicle II","text":"THE GATES DO NOT ALL OPEN ON THE SAME DAY. WE LEARNED TO ASK 'WHEN?' BEFORE 'WHERE?'. SOME LEAD TO WORLDS IN THEIR NOON, SOME TO WORLDS IN THEIR FAMINE, A FEW TO PLACES WHERE NOTHING REMAINS BUT WIND."},{"type":"say","who":"Kenji","text":"So a door here does not open on the same year there."},{"type":"say","who":"Lyra","text":"Which means whatever is on the other side of any gate, the people in it may already be too late, or about to be."},{"type":"flag","key":"eg_t2"}]},{"id":"eg_p3","name":"Chronicle III","x":-6.5,"z":9.0,"w":3.4,"d":2.6,"trigger":"talk","prompt":"Read the plate","actions":[{"type":"say","who":"Chronicle III","text":"BUT SOME DOORS OPENED ON WORLDS WHOSE POWERS COULD NOT BE CARRIED SAFELY. ONE SPARK SPILLING THROUGH COULD BURN A NEIGHBOURING SKY."},{"type":"say","who":"Chronicle III","text":"THE CROWN SEALED THOSE GATES AND SET GUARDIANS UPON THE KEYS. ACCESS TO THE DANGEROUS WORLDS WAS FORBIDDEN, AND WE CALLED THIS WISDOM."},{"type":"say","who":"Lyra","text":"The Shard Vault. The lattice, the wardens, the sealed door. That was one of their locks."},{"type":"say","who":"Miya","text":"Then Rook, the Mind, whoever he is, simply walked through a door the old kingdom shut."},{"type":"flag","key":"eg_t3"}]},{"id":"eg_p4","name":"Chronicle IV","x":6.5,"z":3.0,"w":3.4,"d":2.6,"trigger":"talk","prompt":"Read the plate","actions":[{"type":"say","who":"Chronicle IV","text":"THEN THE ROYAL SCHOLARS FOUND THE THING WE WRITE HERE WITH SHAME. CERTAIN GATES WERE NOT OURS. THEY HAD BEEN OPENED FROM THE OTHER SIDE: NOT TO TRAVEL, BUT TO OBSERVE."},{"type":"say","who":"Chronicle IV","text":"SOMEONE HAD BEEN WATCHING THE WORLDS. SOMEONE HAD BEEN RECORDING THE RISE AND FALL OF PEOPLES. AND SOMEONE HAD BEGUN TO LEAN UPON THEM."},{"type":"say","who":"Miya","text":"Lean?"},{"type":"say","who":"Lyra","text":"Influence. A rumour to a king, a bad harvest left unmended, a door left unlocked. Small pushes."},{"type":"say","who":"Kenji","text":"The Mind."},{"type":"say","who":"Lyra","text":"The plate does not name him."},{"type":"say","who":"Kenji","text":"It does not have to."},{"type":"say","who":"","text":"A faint cold gathers in the west alcove of the great hall ahead."},{"type":"flag","key":"eg_t4"}]},{"id":"eg_plq0","name":"Gate plaque","x":-22.0,"z":-41.1,"w":3.4,"d":2.2,"trigger":"talk","prompt":"Read the plaque","actions":[{"type":"say","who":"Gate Plaque","text":"HOLLOWMERE. A DROWNED KINGDOM. THE WATER DID NOT RECEDE. THE GATE SHOWS ONLY SLOW GREEN LIGHT."}]},{"id":"eg_plq1","name":"Gate plaque","x":-13.2,"z":-41.1,"w":3.4,"d":2.2,"trigger":"talk","prompt":"Read the plaque","actions":[{"type":"say","who":"Gate Plaque","text":"THE GLASS REACH. A MERCHANT-PRINCEDOM AT ITS NOON. THREE MOONS, SIX THOUSAND LANTERNS. THE GATE IS DARK; ITS KEY IS MISSING."}]},{"id":"eg_plq2","name":"Gate plaque","x":-4.4,"z":-41.1,"w":3.4,"d":2.2,"trigger":"talk","prompt":"Read the plaque","actions":[{"type":"say","who":"Gate Plaque","text":"VEYRA, THE KINGDOM OF ASH. A KINGDOM THAT BURNS ITS OWN HEARTH TO KEEP WARM. TWENTY WINTERS INTO THE ASHFALL."}]},{"id":"eg_plq3","name":"Gate plaque","x":4.4,"z":-41.1,"w":3.4,"d":2.2,"trigger":"talk","prompt":"Read the plaque","actions":[{"type":"say","who":"Gate Plaque","text":"NINEFOLD. NINE REALMS AT WAR, EACH TOLD THE OTHERS STARTED IT. THE GATE IS SEALED FROM THE OTHER SIDE."},{"type":"say","who":"Gate Plaque","text":"THIS GATE ALONE STILL ANSWERS THE KEY IN THE ROYAL HAND.","hide":"eg_core"},{"type":"say","who":"Gate Plaque","text":"THE GATE IS OPEN. THE ASH IS FALLING ON THE FAR SIDE; THE WINTER IS OLD.","show":"eg_core"}]},{"id":"eg_plq4","name":"Gate plaque","x":13.2,"z":-41.1,"w":3.4,"d":2.2,"trigger":"talk","prompt":"Read the plaque","actions":[{"type":"say","who":"Gate Plaque","text":"CINDERHOLD. NOTHING REMAINS BUT WIND. THE GATE REMEMBERS A CITY AND OFFERS ONLY DUST."}]},{"id":"eg_plq5","name":"Gate plaque","x":22.0,"z":-41.1,"w":3.4,"d":2.2,"trigger":"talk","prompt":"Read the plaque","actions":[{"type":"say","who":"Gate Plaque","text":"THE LAST ORCHARD. A GARDEN WORLD, OR WHAT IS LEFT OF ONE. THE GATE FLICKERS AND GIVES NOTHING."}]},{"id":"eg_veyra","name":"The Veyra gate","x":4.4,"z":-44.6,"w":7.0,"d":3.6,"trigger":"talk","prompt":"Look through the gate","actions":[{"type":"say","who":"","text":"The gate holds open on a wall of falling grey. Cold wind carries the smell of old fires. Somewhere beyond it, a bell is tolling for the dead, slowly, as if there were no hurry left to hurry for."},{"type":"choice","who":"Kenji","text":"Step through to Veyra?","options":[{"label":"Step through (you can come back through this gate)","actions":[{"type":"flag","key":"eg_veyra_go"},{"type":"fade","to":"black","t":1.4},{"type":"title","text":"Veyra","sub":"The Kingdom of Ash","t":3.4},{"type":"warp","scene":"veyra","x":0,"z":28,"fresh":true}]},{"label":"Not yet","actions":[{"type":"end"}]}]}],"showIf":"eg_core"},{"id":"eg_ledger","name":"The Watcher's Ledger","x":-37.8,"z":-30.0,"w":5.0,"d":5.0,"trigger":"talk","prompt":"Read the Ledger","actions":[{"type":"say","who":"","text":"Black glass stands in a half-circle, each pane showing a world: a drowned city under green light, a glass market beneath three moons, a battlefield older than its flags. Under each, a line of fine script rewrites itself as you watch.","unless":"eg_t4"},{"type":"say","who":"","text":"You have not read enough to understand what you are looking at. The old plates in the hall may help.","unless":"eg_t4"},{"type":"say","who":"","text":"Black glass stands in a half-circle, each pane showing a world: a drowned city under green light, a glass market beneath three moons, a battlefield older than its flags. Under each, a line of fine script rewrites itself as you watch.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Lyra","text":"Observation records. They are live. Whoever wrote the plates said a watcher had opened gates from the other side. This is what he saw.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Ledger","text":"HOLLOWMERE. PRESSURE APPLIED 410 SEASONS PAST: A SEA-WALL LEFT UNMENDED, A WARNING SUPPRESSED. OUTCOME: EXTINCTION.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Ledger","text":"THE GLASS REACH. PRESSURE APPLIED: A SCHISM IN THE MERCHANT COUNCIL. OUTCOME: ONGOING, UNFAVOURABLE.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Ledger","text":"VEYRA. PRESSURE APPLIED, TWENTY WINTERS: THE THRONE RECEIVES INCOMPLETE REPORTS. PEACEFUL COUNSELS SUPPRESSED. EVERY SACRIFICE APPEARS NECESSARY. OUTCOME: FAILING. INTERVENTION SUBJECT RECOMMENDED.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Miya","text":"Every entry ends the same way. Not with a cause. With a result he wanted to measure.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Ledger","text":"SUBJECT: KENJI. ARRIVED AT ELDERGATE. ........ PROCEEDING.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Kenji","text":"He is writing about me. While I stand here reading it.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Lyra","text":"He does not control every disaster. He does not need to. He finds the crack in a world, and he leans.","if":"eg_t4","unless":"eg_ledger"},{"type":"say","who":"Kenji","text":"Then we find the crack first.","if":"eg_t4","unless":"eg_ledger"},{"type":"flag","key":"eg_ledger","if":"eg_t4"},{"type":"say","who":"","text":"The glass keeps writing. The last line has gone dark. The line above it reads: VEYRA. PROCEEDING.","if":"eg_ledger"}]},{"id":"eg_p5","name":"The Last King's seat","x":32.8,"z":-30.0,"w":4.0,"d":3.4,"trigger":"talk","prompt":"Read the plate","actions":[{"type":"say","who":"Chronicle V","text":"THE KING WOULD HAVE THE NETWORK BROKEN. HALF THE KINGDOM WOULD NOT HEAR IT. THE COLLEGES SPLIT. THE CROWN FRACTURED. HE ORDERED THE GATES SEALED, ONE BY ONE."},{"type":"say","who":"Chronicle V","text":"THE LAST GATE HAD NOT YET CLOSED WHEN IT FELL. THE CASTLE CAME DOWN UPON ITS OWN FOUNDATIONS. THE ROYAL HOUSE WAS NEVER FOUND. THE NETWORK WAS BURIED WITH US."},{"type":"say","who":"Chronicle V","text":"LET WHOEVER READS THIS KNOW WE WERE NOT ENEMIES. ONLY FRIGHTENED. AND FRIGHT, LEFT TO ITSELF, BUILDS THE VERY WALLS IT FEARS."},{"type":"say","who":"Miya","text":"The Grey Tide. That is what the survivors called the Fall of the Last Gate."},{"type":"say","who":"Lyra","text":"Brannoch's stones remembered the sunrise. These remember the end of it."},{"type":"say","who":"Kenji","text":"A capital built to keep every world connected, and it died of a quarrel over whether to disconnect them. Come on. I think the Core is waiting."},{"type":"flag","key":"eg_t5"}]},{"id":"eg_core","name":"The Core","x":0.0,"z":-21.6,"w":5.0,"d":3.6,"trigger":"talk","prompt":"Touch the Core","actions":[{"type":"say","who":"","text":"The Core is cold stone and dust, a crystal the colour of old ash on a dais carved with nine rings. It looks like nothing at all. It looks like a clock that has been stopped so long it forgot how to be a clock.","unless":"eg_t5"},{"type":"say","who":"Lyra","text":"I would not touch it blind. Read what the builders left, all five plates. The Ledger too, if you can stand to.","unless":"eg_t5"},{"type":"say","who":"Lyra","text":"You have read everything the hall has to say, but you have not looked into the Ledger yet. West alcove. Do that first.","if":"eg_t5","unless":"eg_ledger"},{"type":"say","who":"Kenji","text":"The mark has been warm since the stair. It is hot now.","if":"eg_ledger","unless":"eg_core"},{"type":"cine","on":true,"if":"eg_ledger","unless":"eg_core"},{"type":"cam","x":0,"z":-22,"yaw":0,"pitch":28,"dist":18,"t":1.4,"if":"eg_ledger","unless":"eg_core"},{"type":"say","who":"","text":"Kenji lays his marked hand on the crystal. Gold light runs up his arm and through the dais. The nine rings turn, one after another, for the first time in centuries.","if":"eg_ledger","unless":"eg_core"},{"type":"flash","if":"eg_ledger","unless":"eg_core"},{"type":"shake","if":"eg_ledger","unless":"eg_core"},{"type":"flag","key":"eg_core","if":"eg_ledger","unless":"eg_core"},{"type":"say","who":"","text":"Along the north wall, six gates stir. Five cough dust and die. The sixth holds, and burns amber.","unless":"eg_core_done","if":"eg_core"},{"type":"say","who":"Lyra","text":"The Network is barely working. Whatever kept it alive kept it outside of time, but it is running on the last of that. One door answers. One.","unless":"eg_core_done","if":"eg_core"},{"type":"say","who":"Miya","text":"Veyra. The same name the Ledger finished on.","unless":"eg_core_done","if":"eg_core"},{"type":"say","who":"Kenji","text":"He is pointing us at it. Or leaning on it and waiting to see what we do.","unless":"eg_core_done","if":"eg_core"},{"type":"say","who":"Lyra","text":"Does it matter which?","unless":"eg_core_done","if":"eg_core"},{"type":"say","who":"Kenji","text":"No. If there are people at the other end of that door, I am going. And when I get there I do the one thing he did not plan for.","unless":"eg_core_done","if":"eg_core"},{"type":"flag","key":"eg_core_done","if":"eg_core"},{"type":"follow","t":1.2,"if":"eg_core"},{"type":"say","who":"","text":"The Core hums low and steady. Behind you, the amber gate waits.","if":"eg_core_done"}]},{"id":"eg_up","name":"The stair","x":0,"z":27.0,"w":6.0,"d":2.4,"trigger":"talk","prompt":"Climb the Sunken Stair to Dawnwatch","actions":[{"type":"fade","to":"black","t":0.8},{"type":"warp","scene":"strange","x":-20,"z":-23,"fresh":true}]}],"spawn":{"x":0,"z":22},"bounds":{"minX":-52,"maxX":52,"minZ":-62,"maxZ":34},"playerHeight":2.4,"camera":{"pitch":40,"dist":34},"sky":{"type":"layers","base":{"type":"gradient","stops":[[0,"#02010a"],[0.5,"#0a0818"],[1,"#16102c"]]},"layers":[{"url":"/assets/Backgrounds/layers/stars.webp","y":0.3,"height":0.66,"parallax":0.04,"alpha":0.8,"tint":[1,0.95,1.1]}]},"light":{"dir":[-0.3,-1,-0.2],"color":[0.42,0.42,0.6],"ambient":[0.22,0.22,0.34]},"fog":{"color":[0.04,0.03,0.09],"near":40,"far":150},"fx":[{"type":"dust","amount":0.2}]}