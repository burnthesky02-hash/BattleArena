  {
   "id": "sera_infirmary",
   "name": "Miya",
   "title": "Infirmary healer",
   "sprite": "Miya",
   "x": -14.6,
   "z": 3.2,
   "h": 2.4,
   "tint": [
    1,
    1.05,
    1.15,
