   "showIf": "st_hurt,st_free",
   "hideIf": "st_sera_back",
   "reach": 4.6,
   "actions": [
    {
     "type": "say",
     "who": "Miya",
     "text": "Kenji! You are on your feet! They told me the Pit never gives anyone back."
    },
    {
     "type": "say",
     "who": "Kenji",
     "text": "It gave me a collar, and then a crowd that liked the show. I am free, for now. Are you all right? Where have they had you?"
    },
    {
     "type": "say",
     "who": "Miya",
     "text": "Stitching up Captain Varro's drowned men, mostly. The infirmary ran out of chapel hands years ago, so they kept me because I was useful. It was an honest sort of captivity."
    },
    {
     "type": "say",
     "who": "Miya",
     "text": "I never meant to stay. Whatever was singing in that water, I felt it too, and I would like to know what it was. Let me walk with you again."
    },
    {
     "type": "say",
     "who": "Kenji",
     "text": "I would like that. I do not know where this road goes from here, but I would rather not walk it alone."
    },
    {
     "type": "say",
     "who": null,
     "text": "Miya takes up her staff and falls in beside you once more."
    },
    {
     "type": "flag",
     "key": "st_sera_back"
    },
    {
     "type": "away",
     "name": "Miya",
     "away": false
