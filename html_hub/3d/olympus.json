   "actions": [
    {
     "type": "say",
     "who": "",
     "text": "The Hooded Leader staggers back, laughing under the mask."
    },
    {
     "type": "say",
     "who": "Hooded Leader",
     "text": "Did you think the Arena was the end of it? You are only the key. The door has been waiting for you, and so has the One who sent me."
    },
    {
     "type": "say",
     "who": "",
     "text": "The air above the sands tears like cloth. A whirl of violet light drags at your feet, colder than before, and the Colosseum falls away..."
