   "actions": [
    {
     "type": "say",
     "who": "",
     "text": "Sunlight hits you like a wave. The sand is hot, the stands are roaring, and for the first time in a long while nobody holds your chain."
    },
    {
     "type": "say",
     "who": "Gate Warden",
     "text": "Free, are you? The Pit does not often give back what it takes."
    },
    {
     "type": "say",
     "who": "Gate Warden",
     "text": "The Colosseum is yours to walk. Heal up, gear up, fight if you like. When you are ready to go home, the main gate is to the south."
    },
