ers.","tint":[0.75,0.8,0.75,1],"action":"heroes","h":2.4},{"id":"shop","name":"Whisper","title":"Smuggler","sprite":"Kael","x":-26.0,"z":15.4,"line":"Psst. Nothing here fell off a cart. Much. Care to browse?","tint":[0.6,0.6,0.85,1],"action":"shop","h":2.4},{"id":"summon","name":"Hanna","title":"Cell-block seer","sprite":"Sera","x":10.5,"z":18.0,"line":"The old glyph under my cell still answers. Pay the toll and see who comes.","tint":[0.85,0.8,1,1],"action":"summon","reach":5.0,"h":2.4},{"id":"save","name":"The Scribe","title":"Keeper of ledgers","sprite":"Lyra","x":14.5,"z":5.8,"tint":[0.75,0.88,1.15,1],"action":"save_and_quit","h":2.4},{"id":"pr1","name":"Brann","title":"Prisoner","sprite":"Rook","x":-16,"z":-4.2,"tint":[0.55,0.55,0.6,1],"actions":[{"type":"say","who":"Brann","text":"Three years in this cell. The cheering above never stops, you stop hearing it."}],"line":"Three years in this cell. The cheering above never stops, you stop hearing it.","h":2.4},{"id":"pr2","name":"Pale Tessa","title":"Prisoner","sprite":"Lyra","x":-8,"z":-4.2,"tint":[0.55,0.55,0.6,1],"actions":[{"type":"say","who":"Pale Tessa","text":"They take the strong ones to the arena. The strong ones don't come back to the cells."}],"line":"They take the strong ones to the arena. The strong ones don't come back to the cells.","h":2.4},{"id":"pr3","name":"Little Joss","title":"Prisoner","sprite":"Kael","x":8,"z":-4.2,"tint":[0.55,0.55,0.6,1],"actions":[{"type":"say","who":"Little Joss","text":"Don't cross Vex. He isn't cruel, he just never forgets."}],"line":"Don't cross Vex. He isn't cruel, he just never forgets.","h":2.4},{"id":"pr4","name":"The Quiet One","title":"Prisoner","sprite":"Draven","x":16,"z":-4.2,"tint":[0.55,0.55,0.6,1],"actions":[{"type":"say","who":"The Quiet One","text":"..."}],"line":"...","h":2.4}],"events":[{"id":"pit_rules","name":"Rules of the Pit","x":6.0,"z":19.7,"w":3.2,"d":2.4,"trigger":"talk","prompt":"Read the tablet","actions":[{"type":"say","who":"Rules of the Pit","text":"I. THE COLOSSEUM OWNS WHAT THE PORTAL BRINGS. II. A SLAVE FIGHTS WHEN THE OVERSEER SAYS. III. THE CROWD MAY BUY A CHAMPION'S COLLAR. THE PIT HAS NEVER KEPT ONE LONG."}]},{"id":"pit_cot","name":"Your cot","x":0,"z":-1.6,"w":3.8,"d":3.4,"trigger":"talk","prompt":"Sleep on the cot (pass time)","actions":[{"type":"pass_time"}]},{"id":"pit_exit","name":"Stairs up","x":0,"z":21.0,"w":6,"d":3.0,"trigger":"talk","prompt":"Try the gate","actions":[{"type":"say","who":"","text":"The gate to the stairs is barred from the other side. Above it, faintly, the crowd roars.","unless":"st_free"}]},{"id":"pit_arena","name":"Arena door","x":31.0,"z":12.0,"w":5.0,"d":6.0,"trigger":"talk","prompt":"Look through the door","actions":[{"type":"say","who":"","text":"The arena door rumbles with the noise of the crowd. Gatekeeper Brakk opens it when it is your turn. Speak to him to challenge the next rank."}]}],"decals":[{"type":"glow","x":-17.0,"z":20.4,"r":6.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":17.0,"z":20.4,"r":6.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":-17.0,"z":3.6,"r":6.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":17.0,"z":3.6,"r":6.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":-3.2,"z":11.0,"r":6.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":3.2,"z":11.0,"r":6.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":-23.4,"z":11.6,"r":5.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":33.0,"z":8.4,"r":6.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":33.0,"z":15.6,"r":6.0,"color":[1,0.62,0.25,0.85]},{"type":"glow","x":25.0,"z":16.8,"r":4.0,"color":[0.35,0.75,1,0.8]},{"type":"glyph","x":10.5,"z":18.0,"r":3.0,"color":[0.6,0.4,1,1],"spin":14},{"type":"glow","x":0,"z":12.6,"r":5,"color":[1,0.45,0.35,1]},{"type":"glow","x":30.5,"z":12.0,"r":5,"color":[0.55,0.75,1,1]},{"type":"glow","x":0,"z":-1.4,"r":3.5,"color":[1,0.8,0.45,0.9]},{"type":"glow","x":0,"z":-4,"r":3.5,"color":[0.7,0.55,1,1]}],"bounds":{"minX":-33.5,"maxX":33.5,"minZ":-5.5,"maxZ":22.4},"spawn":{"x":0,"z":-3.6},"playerHeight":2.4,"story":true,"freeRank":3,"autorun":[{"if":"st_done","unless":"st_free","minRank":"freeRank","actions":[{"type":"say","who":"","text":"A thunderous chant shakes the dust from the ceiling. Above you, the whole Colosseum is shouting your name."},{"type":"say","who":"Overseer Vex","text":"Rank 2 behind you, and the crowd wants you free. They bought your collar with their cheering. Don't look so surprised."},{"type":"say","who":"Overseer Vex","text":"The Colosseum doesn't keep a champion in a cage. The stairs are open. Go on, before I change my mind."},{"type":"say","who":"","text":"The collar clicks open and falls away. Light spills down the stairs from the sands above."},{"type":"flag","key":"st_free"},{"type":"warp","scene":"olympus","x":0,"z":11}]},{"unless":"st_jailed","actions":[{"type":"say","who":"","text":"The violet light fades. Cold stone against your back, iron bars humming in the dark. Somewhere above, a crowd roars."},{"type":"say","who":"Overseer Vex","text":"On your feet, islander. That portal dropped a fresh one into my pit."},{"type":"say","who":"Overseer Vex","text":"You belong to the Colosseum now. You fight when I say, you bleed when they cheer."},{"type":"say","who":"Overseer Vex","text":"Rise past Rank 2 and the crowd may buy your collar. Until then you are property. Speak to me when you are ready to fight."},{"type":"flag","key":"st_jailed"}]}],"sky":{"type":"gradient","stops":[[0,"#05070d"],[1,"#120d18"]]},"fx":[{"type":"dust","amount":0.25}],"light":{"dir":[-0.35,-1,-0.25],"color":[0.9,0.78,0.7],"ambient":[0.42,0.38,0.45]},"fog":{"color":[0.05,0.04,0.07],"near":40,"far":95}}