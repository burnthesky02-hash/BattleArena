",52,-12,305,0,4.981999014220168],["/assets/3D/Asteroid/SM_ground_rocks",50,18,266,0,4.3508667935317185],["/assets/3D/Asteroid/SM_ground_rocks",-54,38,35,0,4.252800348824207],["/assets/3D/Asteroid/SM_table_01",0,19.5,0,0,1.3],["/assets/3D/Asteroid/SM_door_module",-27,-3,90,0,1.0]],"colliders":[{"x":0,"z":-26,"w":23.406,"d":23.406},{"x":-44,"z":-24,"w":28.952,"d":28.952},{"x":44,"z":-24,"w":28.952,"d":28.952},{"x":-40,"z":10,"w":26.32,"d":17.108},{"x":-36,"z":29,"w":25.662,"d":17.766},{"x":24,"z":31,"w":14.1,"d":14.852},{"x":46,"z":31,"w":19.27,"d":14.852},{"x":38,"z":4,"w":21.0,"d":18.0},{"x":-22,"z":-13.5,"w":1.6,"d":1.6},{"x":22,"z":-13.5,"w":1.6,"d":1.6},{"x":24.0,"z":12.5,"w":1.7,"d":1.7},{"x":25.4,"z":14.0,"w":1.7,"d":1.7},{"x":23.0,"z":15.0,"w":1.7,"d":1.7},{"x":26.0,"z":10.8,"w":1.7,"d":1.7},{"x":22.5,"z":11.2,"w":1.7,"d":1.7},{"x":31,"z":17.6,"w":7.0,"d":5.0},{"x":-21.5,"z":22.0,"w":4.9,"d":3.7},{"x":16.0,"z":26.6,"w":3.7,"d":1.9},{"x":-6,"z":-14.4,"w":1.6,"d":1.8},{"x":6,"z":-14.4,"w":1.6,"d":1.8},{"x":0,"z":19.5,"w":3.4,"d":1.8},{"x":-28.2,"z":-3,"w":2.4,"d":7.0}],"npcs":[{"id":"rhea","name":"Captain Rhea","title":"Outpost Kestrel","sprite":"Yulia","x":0,"z":-9.6,"tint":[0.8,1,1.2,1],"reach":5.0,"actions":[{"type":"say","who":"Captain Rhea","text":"Easy now. You came through the rift, so you are the one the masked raiders wanted. Welcome to Outpost Kestrel, far from any sea.","unless":"st_met"},{"type":"say","who":"Captain Rhea","text":"They have been pulling fighters out of the world and dropping them on rocks like this one. We think the portal at the Colosseum was only the first door.","unless":"st_met"},{"type":"say","who":"Captain Rhea","text":"We have a scholar here who has been studying the rift since she was dragged through it. Lyra. She is usually in the mess hall, west of the pad, buried in notes. Go and talk to her.","unless":"st_met"},{"type":"flag","key":"st_met","unless":"st_met"},{"type":"say","who":"Captain Rhea","text":"Lyra is in the mess hall, west of the landing pad. She knows more about the rift than all of my techs together.","if":"st_met","unless":"st_lyra"},{"type":"say","who":"Captain Rhea","text":"Lyra says there is a vault under the base, and that it is the reason the rift keeps tearing open. I had the old hatch west of the pad unsealed for you. Take Lyra, take care, and come back alive.","if":"st_lyra","unless":"vt_boss"},{"type":"say","who":"Captain Rhea","text":"The Shard stopped singing the moment the Warden fell. Good work. The rift console has a new coordinate on it now. We will find out where it points. For now, rest.","if":"vt_boss"}],"h":2.4},{"id":"battle","name":"Sergeant Kade","title":"Drill Sergeant","sprite":"Draven","x":-13,"z":18.5,"line":"Rift or no rift, soldiers stay sharp. Want a bout in the practice ring?","tint":[0.8,0.95,1.15,1],"action":"battle","h":2.4},{"id":"heroes","name":"Ysol","title":"Technician","sprite":"Lyra","x":13,"z":18.5,"line":"I tune gear and drill skills. Bring me your fighters.","tint":[0.8,1.05,1.1,1],"action":"heroes","h":2.4},{"id":"summon","name":"Oro","title":"Rift Seer","sprite":"Sera","x":-19,"z":3.5,"line":"The rift leaks. Sometimes things climb out of it and want to fight for you.","tint":[0.85,0.9,1.25,1],"action":"summon","reach":5.0,"h":2.4},{"id":"shop","name":"Quartermaster Pike","title":"Supplies","sprite":"Rook","x":22.5,"z":8.2,"line":"Everything we salvaged, for everything you earned. Browse.","tint":[1.1,0.95,0.8,1],"action":"shop","h":2.4},{"id":"save","name":"Archivist","title":"Records","sprite":"Kael","x":0,"z":29.5,"tint":[0.75,0.88,1.15,1],"action":"save_and_quit","h":2.4},{"id":"lyra","name":"Lyra","title":"Rift Scholar","sprite":"Lyra","x":-17.0,"z":19.8,"tint":[1,1,1.1,1],"hideIf":"st_lyra","reach":5.0,"actions":[{"type":"say","who":"Lyra","text":"Another one who fell out of the sky? ...Oh. You are the one the Captain mentioned. You came through the Colosseum portal. Good. I have a map of what is under this base, and I need someone who can fight.","if":"st_met"},{"type":"say","who":"Lyra","text":"I was a scholar at a library very far from here, until a door opened in the reading room and the floor stopped being the floor. Since then I have been tracing where the rift gets its strength.","if":"st_met"},{"type":"say","who":"Lyra","text":"It points down. There is a vault below Kestrel, and something called a Shard in it that is pulling doors open across the world. Wherever you are going next, I would like to come with you.","if":"st_met"},{"type":"recruit","name":"Lyra","if":"st_met"},{"type":"flag","key":"st_lyra","if":"st_met"},{"type":"say","who":"Lyra","text":"Lyra joins your party. The hatch to the vault is west of the landing pad. Equip her at Ysol's bench first; I have no armour to my name.","if":"st_met"},{"type":"say","who":"Lyra","text":"The Captain wants to see you first. She is by the command dome, north of the pad.","unless":"st_met"}],"h":2.4}],"events":[{"id":"rift_console","name":"Rift console","x":0,"z":17.5,"w":4.0,"d":3.0,"trigger":"talk","prompt":"Read the console","actions":[{"type":"say","who":"Rift Console","text":"COORDINATES CYCLING: PARADISE ISLAND... OLYMPUS COLOSSEUM... A third entry flickers and will not resolve. THE RIFT IS SEALED. The way home is not open yet.","unless":"vt_boss"},{"type":"say","who":"Rift Console","text":"COORDINATES CYCLING: PARADISE ISLAND... OLYMPUS COLOSSEUM... A third entry has resolved: UNKNOWN. SIGNAL STRENGTH RISING. The way home is still sealed, but something on the other end has noticed us.","if":"vt_boss"}]},{"id":"ship_note","name":"Landed ship","x":38,"z":14.4,"w":8.0,"d":3.0,"trigger":"talk","prompt":"Look at the ship","actions":[{"type":"say","who":"","text":"Scorched hull plates and a cracked canopy. Someone brought this ship in the hard way."}]},{"id":"vault_hatch","name":"Vault hatch","x":-24.0,"z":-3,"w":4.0,"d":5.0,"trigger":"talk","prompt":"Open the hatch","actions":[{"type":"say","who":"","text":"A heavy hatch, scorched and sealed. Something below it hums.","unless":"st_lyra"},{"type":"say","who":"","text":"The hatch grinds open on a staircase that spirals down into violet light. The air tastes of metal and old storms.","if":"st_lyra"},{"type":"warp","scene":"vault","x":0,"z":10,"if":"st_lyra"}]}],"decals":[{"type":"glyph","x":0,"z":8,"r":4.2,"color":[0.6,0.4,1,1],"spin":18},{"type":"glow","x":0,"z":8,"r":10,"color":[0.5,0.35,1,0.7]},{"type":"glow","x":-12,"z":18,"r":5,"color":[0.4,0.85,1,1]},{"type":"glow","x":12,"z":18,"r":5,"color":[0.4,0.85,1,1]},{"type":"glow","x":0,"z":-9,"r":5,"color":[0.4,0.85,1,1]},{"type":"glow","x":-18,"z":4,"r":5,"color":[0.4,0.85,1,1]},{"type":"glow","x":24,"z":13,"r":5,"color":[0.4,0.85,1,1]},{"type":"glow","x":0,"z":30,"r":5,"color":[0.4,0.85,1,1]},{"type":"glow","x":-22,"z":-13.5,"r":6,"color":[1,0.3,0.3,0.9]},{"type":"glow","x":22,"z":-13.5,"r":6,"color":[1,0.3,0.3,0.9]},{"type":"glow","x":0,"z":-13,"r":8,"color":[1,0.85,0.55,1]},{"type":"glow","x":38,"z":15,"r":6,"color":[0.35,0.6,1,1]},{"type":"glow","x":-38,"z":20,"r":6,"color":[1,0.8,0.5,1]},{"type":"glow","x":-24.5,"z":-3,"r":6,"color":[0.7,0.42,1,0.9]}],"story":true,"autorun":[{"unless":"st_landed","actions":[{"type":"say","who":"","text":"Cold, thin air and the hum of machinery. You stand on a landing pad, stars wheeling overhead. A huge ringed planet hangs in the sky."},{"type":"say","who":"","text":"You are not on the island. You are not in the Colosseum. You are not, by the look of it, even in the same world."},{"type":"say","who":"","text":"A woman in a flight jacket is walking toward you across the pad. Speak to Captain Rhea."},{"type":"flag","key":"st_landed"}]}],"bounds":{"minX":-56,"maxX":56,"minZ":-34,"maxZ":36},"spawn":{"x":0,"z":8},"playerHeight":2.4,"sky":{"type":"layers","base":{"type":"gradient","stops":[[0,"#010208"],[0.5,"#060b1f"],[1,"#171335"]]},"layers":[{"url":"/assets/Backgrounds/layers/stars.webp","y":0.3,"height":0.66,"parallax":0.04,"alpha":1,"tint":[1,1,1.1]},{"url":"/assets/Backgrounds/layers/planet.webp","y":0.26,"height":0.78,"parallax":0.06,"alpha":1,"tile":false,"tint":[1,1,1]},{"url":"/assets/Backgrounds/layers/stars.webp","y":0.55,"height":0.5,"parallax":0.12,"alpha":0.55,"tint":[0.8,0.9,1.2],"drift":0.002}]},"light":{"dir":[-0.55,-1,-0.3],"color":[0.8,0.88,1.0],"ambient":[0.3,0.34,0.5]},"fog":{"color":[0.01,0.015,0.045],"near":120,"far":300}}